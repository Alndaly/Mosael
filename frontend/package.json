    "d3-force": "^3.0.0",
    "lucide-react": "^1.35.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mp4box": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-photo-view": "^1.2.7",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
