{
  "name": "open-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "gen:api": "pnpm -w gen:api",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "//electron:dev": "wait-on 前面那串清空代理的变量不是可有可无的:回环探活不需要代理,而开发者 shell 里导出了 HTTP_PROXY、NO_PROXY 又没覆盖回环时,wait-on 会把 127.0.0.1 的探活送进代理,连接一直挂着不返回 —— Electron 那一步永远不开始,且整个 [electron] 栏一个字都不打印,现象是「启动看着正常但 app 没打开」,极难往代理上想。",
    "electron:dev": "pnpm --dir .. build:publisher && pnpm --dir .. build:system && concurrently -k -n vite,bundle,backend,electron -c cyan,yellow,magenta,green \"pnpm dev\" \"pnpm --dir .. watch:publisher\" \"pnpm --dir .. dev:backend\" \"HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 wait-on http://127.0.0.1:5173 http://127.0.0.1:${OPEN_STUDIO_BACKEND_PORT:-8800}/api/health && node ../electron/brand-dev.cjs && electron ../electron/main.cjs\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@uiw/react-codemirror": "^4.25.11",
