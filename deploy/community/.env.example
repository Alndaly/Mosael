# Mosael 官网 + 社区服务的环境变量。复制成 .env 再改(.env 不进仓库)。
# 所有值都是占位符 —— 这里没有、也不该有任何真实的密钥。说明见 docs/DEPLOY_COMMUNITY.md。

# ======================== compose 自己用的 ========================
# 站点域名(已备案、已解析到这台服务器)。Caddy 用它申请 HTTPS 证书。
SITE_DOMAIN=example.com
# 证书到期提醒发到这个邮箱(可空)。
ACME_EMAIL=ops@example.com
# PostgreSQL 的密码。随机生成一个长串:openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password
# 可选的 MinIO(--profile minio)的管理员账号与密码。
MINIO_ROOT_USER=mosael
MINIO_ROOT_PASSWORD=change-me-minio-password

# ======================== 社区服务:基础 ========================
# 运行环境:production(生产)/ development(本地开发)/ test(测试)。compose 里固定为 production。
COMMUNITY_ENV=production
# 站点的公开地址(没有结尾斜杠)。分享链接、设备授权的验证地址、本地存储的上传地址都用它拼。
COMMUNITY_PUBLIC_URL=https://example.com
# 数据目录(容器里是 /data,不用改)。本地开发时缺省的 SQLite、文件、开发密钥都放在这里。
COMMUNITY_DATA_DIR=/data
# 数据库地址。compose 里由 POSTGRES_PASSWORD 拼好了,这里留空即可;不用 compose 时写成
# postgresql+psycopg://用户:密码@主机:5432/库名
COMMUNITY_DATABASE_URL=
# 服务端 HMAC 密钥(至少 32 个字符):短信验证码的哈希、上传地址的签名都用它。openssl rand -base64 48
# 换了它:没用掉的验证码、没传完的上传地址、20 秒宽限期内的并发刷新会失效(都是几分钟内的事)。
COMMUNITY_SECRET_KEY=change-me-at-least-32-characters-long-secret
# 日志级别与格式(json / text)。
COMMUNITY_LOG_LEVEL=INFO
COMMUNITY_LOG_FORMAT=json

# ======================== 令牌 ========================
# Ed25519 私钥(PEM)。二选一:内容(换行写成 \n)或文件路径。compose 里固定用文件
# /data/keys/jwt-ed25519.pem(由 gen-jwt-key 生成在 community_keys 卷里),这两项留空。
COMMUNITY_JWT_PRIVATE_KEY=
COMMUNITY_JWT_PRIVATE_KEY_FILE=
# 访问令牌有效期(秒),缺省 15 分钟。
COMMUNITY_ACCESS_TOKEN_TTL_SECONDS=900
# 刷新令牌:滑动窗口(天)、绝对上限(天)、轮换后的并发宽限期(秒)。
COMMUNITY_REFRESH_IDLE_DAYS=30
COMMUNITY_REFRESH_ABSOLUTE_DAYS=90
COMMUNITY_REFRESH_GRACE_SECONDS=20
# 刷新令牌 cookie 带不带 Secure。生产必须是 true;不写时开发环境自动关、其余开。
COMMUNITY_COOKIE_SECURE=true
# 刷新令牌 cookie 的名字与 Path(Path 必须是刷新接口 /api/community/v1/auth/refresh 的前缀)。
COMMUNITY_REFRESH_COOKIE_NAME=mosael_refresh
COMMUNITY_REFRESH_COOKIE_PATH=/api/community/v1/auth

# ======================== 协议 ========================
# 当前《用户协议》《隐私政策》的版本号。改了之后,登录、注册要带上新版本号才放行(官网据此让用户重新勾选)。
COMMUNITY_TERMS_VERSION=1

# ======================== 短信(腾讯云) ========================
# 发送器:tencent(生产)/ console(开发:验证码打到日志里,生产环境不允许)。
COMMUNITY_SMS_SENDER=tencent
# 开发用的固定验证码(如 000000)。只有 COMMUNITY_ENV=development 才接受,生产必须留空。
COMMUNITY_DEV_SMS_CODE=
# 腾讯云 API 密钥(CAM 子用户的 SecretId / SecretKey,只授予短信发送与验证码校验的权限)。
COMMUNITY_TENCENT_SECRET_ID=replace-with-cam-sub-user-secret-id
COMMUNITY_TENCENT_SECRET_KEY=change-me-tencent-secret-key
# 短信的地域、应用 SdkAppId、签名内容(审核通过的签名名称,不是签名 ID)。
COMMUNITY_TENCENT_SMS_REGION=ap-guangzhou
COMMUNITY_TENCENT_SMS_SDK_APP_ID=1400000000
COMMUNITY_TENCENT_SMS_SIGN_NAME=示例签名
# 验证码模板 ID。三种用途(登录 / 绑定注册 / 找回密码)可以各配一个;没配的用第一个。
COMMUNITY_TENCENT_SMS_TEMPLATE_ID=1000000
COMMUNITY_TENCENT_SMS_TEMPLATE_ID_LOGIN=
COMMUNITY_TENCENT_SMS_TEMPLATE_ID_BIND=
COMMUNITY_TENCENT_SMS_TEMPLATE_ID_RESET=
# 模板变量的顺序:code = 验证码,minutes = 有效分钟数。模板「验证码为{1},{2}分钟内有效」就是 code,minutes;
# 模板只有一个变量「验证码为{1}」就写 code。
COMMUNITY_TENCENT_SMS_TEMPLATE_PARAMS=code,minutes
# 验证码有效期(秒)、单个码最多试几次、同号重发间隔(秒)、同号每 24 小时上限、同 IP 每小时上限。
COMMUNITY_SMS_CODE_TTL_SECONDS=300
COMMUNITY_SMS_MAX_ATTEMPTS=5
COMMUNITY_SMS_RESEND_SECONDS=60
COMMUNITY_SMS_DAILY_LIMIT_PER_PHONE=10
COMMUNITY_SMS_HOURLY_LIMIT_PER_IP=20

# ======================== 人机验证(腾讯云验证码 / 天御,可选) ========================
# 两项都配了就启用:发短信前必须带上验证码票据。CaptchaAppId 是公开的(官网前端也要用)。
COMMUNITY_CAPTCHA_APP_ID=
COMMUNITY_CAPTCHA_APP_SECRET_KEY=

# ======================== 密码登录与通用限速 ========================
# 同一账号连续失败几次锁定、锁多久(秒);同一 IP 在窗口(秒)内失败几次锁到窗口结束。
COMMUNITY_PASSWORD_ACCOUNT_MAX_FAILURES=5
COMMUNITY_PASSWORD_ACCOUNT_LOCK_SECONDS=900
COMMUNITY_PASSWORD_IP_MAX_FAILURES=30
COMMUNITY_PASSWORD_IP_WINDOW_SECONDS=900
# 同一 IP 每分钟的写请求上限(每个进程各数各的,是一道粗闸;0 = 关)。
COMMUNITY_WRITE_REQUESTS_PER_MINUTE=120

# ======================== 存储 ========================
# local:服务器磁盘(compose 的 community_media 卷,Caddy 直接出);s3:S3 兼容对象存储。
COMMUNITY_STORAGE=local
# 本地存储目录(容器里 /data/media,不用改)。
COMMUNITY_STORAGE_DIR=/data/media
# 本地存储文件的 URL 前缀(和 Caddyfile 里的 /community-media 对上)。不写时生产是 /community-media。
COMMUNITY_MEDIA_URL_PREFIX=/community-media
# 服务自己出本地存储的文件(开发用)。不写时开发环境开、其余关。
COMMUNITY_SERVE_MEDIA=false
# S3 兼容存储(COMMUNITY_STORAGE=s3 时):
#   腾讯云 COS:endpoint https://cos.ap-guangzhou.myqcloud.com,region ap-guangzhou,addressing_style virtual
#   阿里云 OSS:endpoint https://oss-cn-hangzhou.aliyuncs.com,region cn-hangzhou,addressing_style virtual
#   MinIO:endpoint https://minio.example.com,region us-east-1,addressing_style path
COMMUNITY_S3_ENDPOINT=
COMMUNITY_S3_REGION=
COMMUNITY_S3_BUCKET=
COMMUNITY_S3_ACCESS_KEY_ID=
COMMUNITY_S3_SECRET_ACCESS_KEY=
COMMUNITY_S3_ADDRESSING_STYLE=virtual
# 公开读的 CDN / 桶地址(可选)。不配:媒体给预签名 GET 地址(有效期见下)。
COMMUNITY_S3_PUBLIC_URL=
# 上传地址、下载地址的有效期(秒)。
COMMUNITY_UPLOAD_URL_TTL_SECONDS=3600
COMMUNITY_DOWNLOAD_URL_TTL_SECONDS=3600

# ======================== 限额 ========================
# 画板分享:每张快照最多几格、单个文件上限、单张画板文件总量上限、每个用户的存储上限(字节)。
COMMUNITY_SHARE_MAX_ITEMS=300
COMMUNITY_SHARE_MAX_FILE_BYTES=209715200
COMMUNITY_SHARE_MAX_TOTAL_BYTES=1073741824
COMMUNITY_USER_STORAGE_QUOTA_BYTES=5368709120
# 插件包:压缩包上限、解压后上限、文件数上限;工作流文件上限;封面图上限;普通 JSON 请求体上限(字节)。
COMMUNITY_PLUGIN_MAX_BYTES=67108864
COMMUNITY_PLUGIN_MAX_UNPACKED_BYTES=268435456
COMMUNITY_PLUGIN_MAX_FILES=2000
COMMUNITY_WORKFLOW_MAX_BYTES=5242880
COMMUNITY_COVER_MAX_BYTES=5242880
COMMUNITY_JSON_BODY_MAX_BYTES=16777216

# ======================== 分享预览图与官方条目(镜像里已设好,一般不用改) ========================
COMMUNITY_OG_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
COMMUNITY_OG_WORDMARK_PATH=/app/assets/mosael-wordmark-tight.png
COMMUNITY_OFFICIAL_CATALOG_DIR=/app/official-catalog
