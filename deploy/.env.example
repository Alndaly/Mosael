# Mosael 一键部署的环境变量。复制成 .env 再改;.env 不进仓库(docker-compose.yml 会读它)。
# 这里没有、也不该有任何真实密钥 —— 下面是占位符。每一项都写了"是什么"和"不填会怎样"。
# 只有 DOMAIN 和 POSTGRES_PASSWORD 是必填;SMTP / OAuth 留空 = 明确地不启用。

# ============================================================ 必填
# 你的域名(只写主机名,例如 mosael.example.com;不要 https://、不要路径、不要结尾斜杠)。
# 它同时决定:Cloud 的同源校验 Origin、OAuth 回调地址。
# **nginx 不读这个文件**:deploy/nginx/mosael.conf 里的 ${DOMAIN} 要手动/sed 换成同一个域名。
# 留空:compose 拒绝启动;写成带 https://、路径或结尾斜杠的形式:同源校验和 OAuth 会出错。
DOMAIN=example.com

# PostgreSQL 的密码。会被拼进 CLOUD_DATABASE_URL,所以只用 URL 安全字符 ——
# 推荐 `openssl rand -hex 32`(纯十六进制),别用带 @ : / # % 的随机串。
# 留空:compose 拒绝启动。首次初始化后改它不会改数据库里的密码(见 README 故障对照)。
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-32

# ============================================================ 回环端口(可选)
# compose 只把官网 / Cloud 绑在 127.0.0.1 上,80/443 由机器上已有的 nginx 监听。
# 3000/8901 被别的进程占用时才改;改完 nginx 配置里的两处 proxy_pass 也要一起改。
# 留空:compose 用 3000 / 8901。
WEBSITE_PORT=3000
CLOUD_PORT=8901

# ============================================================ MosaelCloud:会话与设备码
# 登录会话有效期(天)。不填:30。
CLOUD_SESSION_TTL_DAYS=30
# 桌面端设备码有效期(秒)。不填:600。
CLOUD_DEVICE_CODE_TTL_SECONDS=600
# 桌面端轮询设备码的间隔(秒)。不填:5。
CLOUD_DEVICE_POLL_INTERVAL_SECONDS=5
# 密码长度下限(字符)。不填:8。
CLOUD_PASSWORD_MIN_LENGTH=8
# 一次第三方登录的 state / nonce 有效期(秒)。不填:600。
CLOUD_OAUTH_STATE_TTL_SECONDS=600

# ============================================================ MosaelCloud:发信(SMTP,可选)
# 不配 SMTP 时:注册 / 登录验证码接口明确回 503 `mail_not_configured`,官网提示"还没配置发信",
# 不会假装发出去 —— 这是有意的。要用邮箱验证码就填下面几项。
#
# SMTP 主机,可写 host 或 host:port(写了端口就以它为准)。
# 留空:发码功能关闭(503)。
CLOUD_SMTP_HOST=
# SMTP 端口(host 里没写端口时用)。留空:587。
CLOUD_SMTP_PORT=587
# 加密方式:starttls(587)/ ssl(465)/ none(本地 Mailpit)。
# 留空:有用户名时 starttls,没有用户名时 none —— 本地 `CLOUD_SMTP_HOST=localhost:1025` 只填一项就能用。
CLOUD_SMTP_TLS=
# SMTP 用户名。留空:不登录(匿名中继 / Mailpit)。
CLOUD_SMTP_USERNAME=
# SMTP 密码。留空:不登录。只交给 SMTP,不会进日志。
CLOUD_SMTP_PASSWORD=
# 发件人地址。留空:用代码缺省 no-reply@mosael.com(多数 SMTP 会拒;建议填自己域名下已授权的地址)。
CLOUD_SMTP_FROM=

# ============================================================ MosaelCloud:第三方登录(可选)
# GitHub OAuth App 的 client id / secret。任一留空 = 未启用:官网不显示 GitHub 按钮,
# 入口回官网并带 oauth_error=oauth_not_configured。
# 回调地址:https://<DOMAIN>/api/cloud/v1/oauth/github/callback
CLOUD_GITHUB_CLIENT_ID=
CLOUD_GITHUB_CLIENT_SECRET=

# Google OAuth 客户端的 client id / secret。任一留空 = 未启用,表现同上。
# 回调地址:https://<DOMAIN>/api/cloud/v1/oauth/google/callback
CLOUD_GOOGLE_CLIENT_ID=
CLOUD_GOOGLE_CLIENT_SECRET=

# ============================================================ 官网(可选)
# GA4 Measurement ID(公开值,不是密钥)。留空:官网不注入 Google Analytics,不发分析数据。
# **构建期变量**:改完要 `docker compose build website` 再 `up -d`。
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# 搜索引擎站长验证的 content 值(不是整段 <meta>);同样是构建期变量,改完要重新 build website。
# Google 的验证值。留空:不出 Google 的 meta 标签。
SITE_VERIFICATION_GOOGLE=
# 百度的验证值。留空:不出百度的 meta 标签。
SITE_VERIFICATION_BAIDU=
# Bing 的验证值。留空:不出 Bing 的 meta 标签。
SITE_VERIFICATION_BING=
# 360 的验证值。留空:不出 360 的 meta 标签。
SITE_VERIFICATION_360=
# 搜狗的验证值。留空:不出搜狗的 meta 标签。
SITE_VERIFICATION_SOGOU=

# ============================================================ 过期数据清理
# 清理间隔(秒)。不填:3600。只删 expires_at 已过去的三类短期数据
# (cloud_email_codes / cloud_sessions / cloud_oauth_states),不碰用户与设备。
CLEANUP_INTERVAL_SECONDS=3600

# ============================================================ 由 compose 固定,不用在这里配
# CLOUD_PUBLIC_URL=https://${DOMAIN}     —— 同源 Origin 与 OAuth 回调都由它推出
# CLOUD_COOKIE_SECURE=true              —— 生产必须 Secure,不要在 compose 里关掉
# CLOUD_DATABASE_URL=postgresql+psycopg://mosael:<POSTGRES_PASSWORD>@postgres:5432/mosael
# CLOUD_DATA_DIR=/data、CLOUD_API_URL=http://cloud:8000
