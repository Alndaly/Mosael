{
  "name": "mibu",
  "version": "0.1.0",
  "private": true,
  "description": "Mibu — AI video creative studio",
  "repository": "https://github.com/Alndaly/mibu-cut",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build:frontend": "pnpm --dir frontend build",
    "build:sidecar": "pnpm --dir agent-sidecar build",
    "build:backend": "cd backend && .venv/bin/pyinstaller --noconfirm --clean --onedir --name mibu-backend --hidden-import uvicorn.logging --hidden-import uvicorn.loops.auto --hidden-import uvicorn.protocols.http.auto --hidden-import uvicorn.protocols.websockets.auto --hidden-import uvicorn.lifespan.on run_backend.py",
    "build:mac": "pnpm build:publisher && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dir",
    "dist:mac": "pnpm build:publisher && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dmg",
    "build:publisher": "esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs",
    "watch:publisher": "esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs --watch=forever",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${MIBU_BACKEND_PORT:-8800} --reload",
    "dev": "pnpm --dir frontend electron:dev"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "dev.mibu.studio",
    "productName": "Mibu",
    "publish": [
      {
        "provider": "github",
        "owner": "Alndaly",
        "repo": "mibu-cut"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/mibu-backend",
        "to": "backend/mibu-backend"
      },
      {
        "from": "agent-sidecar/dist/sidecar.cjs",
        "to": "agent-sidecar/sidecar.cjs"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
