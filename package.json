{
  "name": "mosael",
  "version": "1.0.0-beta1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Mosael — AI video creative studio",
  "author": "Kinda Hall (https://x.com/KindaHuaX)",
  "homepage": "https://mosael.com",
  "repository": "https://github.com/Alndaly/Mosael",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build:frontend": "pnpm --dir frontend build",
    "build:sidecar": "pnpm --dir agent-sidecar build",
    "build:extension": "pnpm --dir browser-extension build",
    "build:backend": "cd backend && uv run --frozen pyinstaller --noconfirm --clean --onedir --name mosael-backend --hidden-import uvicorn.logging --hidden-import uvicorn.loops.auto --hidden-import uvicorn.protocols.http.auto --hidden-import uvicorn.protocols.websockets.auto --hidden-import uvicorn.lifespan.on --add-data app/ai/runtime/workers/tts.py:app/ai/runtime/workers --add-data app/ai/runtime/workers/tts_protocol.py:app/ai/runtime/workers --add-data app/ai/runtime/workers/asr.py:app/ai/runtime/workers run_backend.py",
    "build:mac": "pnpm fetch:tts-python && pnpm build:preload && pnpm build:publisher && pnpm build:system && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dir",
    "dist:mac": "pnpm fetch:tts-python && pnpm build:preload && pnpm build:publisher && pnpm build:system && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dmg",
    "build:preload": "esbuild electron/preload.cjs --bundle --platform=node --format=cjs --external:electron --outfile=electron/preload.bundle.cjs",
    "watch:preload": "esbuild electron/preload.cjs --bundle --platform=node --format=cjs --external:electron --outfile=electron/preload.bundle.cjs --watch=forever",
    "build:publisher": "pnpm typecheck:electron && esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs",
    "watch:publisher": "esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs --watch=forever",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${MOSAEL_BACKEND_PORT:-8800} --reload",
    "dev": "pnpm --dir frontend electron:dev",
    "fetch:tts-python": "node scripts/fetch-tts-python.mjs",
    "typecheck:electron": "pnpm -C frontend exec tsc --noEmit -p ../electron/tsconfig.json",
    "build:system": "pnpm typecheck:electron && esbuild electron/system/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/system.bundle.cjs",
    "gen:api": "openapi-typescript backend/openapi.json -o frontend/src/api/generated/schema.d.ts"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "openapi-typescript": "^7.13.0"
  },
  "build": {
    "appId": "dev.mosael.app",
    "productName": "Mosael",
    "publish": [
      {
        "provider": "github",
        "owner": "Alndaly",
        "repo": "Mosael"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "package.json",
      "build/icon.png",
      "build/tray*.png"
    ],
    "extraResources": [
      {
        "from": "backend/dist/mosael-backend",
        "to": "backend/mosael-backend"
      },
      {
        "from": "agent-sidecar/dist/sidecar.cjs",
        "to": "agent-sidecar/sidecar.cjs"
      },
      {
        "from": "build/python",
        "to": "python"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Mosael needs access to system audio when you include device audio in a screen recording.",
        "NSCameraUsageDescription": "Mosael needs camera access when you record a camera asset.",
        "NSMicrophoneUsageDescription": "Mosael needs microphone access when you record narration or a camera asset."
      },
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "Mosael",
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "uninstallDisplayName": "Mosael"
    },
    "protocols": [
      {
        "name": "Mosael",
        "schemes": [
          "mosael"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "mkv",
          "webm"
        ],
        "name": "视频",
        "role": "Editor"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac"
        ],
        "name": "音频",
        "role": "Editor"
      }
    ]
  }
}
