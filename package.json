{
  "name": "open-studio",
  "version": "0.4.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Open Studio — AI video creative studio",
  "repository": "https://github.com/Alndaly/OpenStudio",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build:frontend": "pnpm --dir frontend build",
    "build:sidecar": "pnpm --dir agent-sidecar build",
    "build:backend": "cd backend && uv run --frozen pyinstaller --noconfirm --clean --onedir --name open-studio-backend --hidden-import uvicorn.logging --hidden-import uvicorn.loops.auto --hidden-import uvicorn.protocols.http.auto --hidden-import uvicorn.protocols.websockets.auto --hidden-import uvicorn.lifespan.on run_backend.py",
    "build:mac": "pnpm fetch:tts-python && pnpm build:publisher && pnpm build:system && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dir",
    "dist:mac": "pnpm fetch:tts-python && pnpm build:publisher && pnpm build:system && pnpm build:frontend && pnpm build:sidecar && pnpm build:backend && electron-builder --mac dmg",
    "build:publisher": "esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs",
    "watch:publisher": "esbuild electron/publish/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/publish.bundle.cjs --watch=forever",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${OPEN_STUDIO_BACKEND_PORT:-8800} --reload",
    "dev": "pnpm --dir frontend electron:dev",
    "fetch:tts-python": "node scripts/fetch-tts-python.mjs",
    "typecheck:electron": "pnpm -C frontend exec tsc --noEmit -p ../electron/tsconfig.json",
    "build:system": "esbuild electron/system/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/system.bundle.cjs",
    "gen:api": "openapi-typescript backend/openapi.json -o frontend/src/api/generated/schema.d.ts"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "openapi-typescript": "^7.13.0"
  },
  "build": {
    "appId": "dev.openstudio.app",
    "productName": "Open Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "Alndaly",
        "repo": "OpenStudio"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "backend/dist/open-studio-backend",
        "to": "backend/open-studio-backend"
      },
      {
        "from": "agent-sidecar/dist/sidecar.cjs",
        "to": "agent-sidecar/sidecar.cjs"
      },
      {
        "from": "build/python",
        "to": "python"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "Open Studio",
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "uninstallDisplayName": "Open Studio"
    },
    "protocols": [
      {
        "name": "Open Studio",
        "schemes": [
          "openstudio"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "mkv",
          "webm"
        ],
        "name": "视频",
        "role": "Editor"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac"
        ],
        "name": "音频",
        "role": "Editor"
      }
    ]
  }
}
