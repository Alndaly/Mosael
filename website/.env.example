# Public GA4 Measurement ID. Leave empty to omit Google Analytics entirely.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-YDRX2Y5WZS

# 社区服务(ADR 0026)。运行时读;留空 = 社区页显示「社区未开放」,文档照常。
# 本地开发时 /api/community/* 也经 next.config.ts 的 rewrite 转到这里。
COMMUNITY_API_URL=
# 分享查看页 CSP 放行的媒体存储 origin(S3 / COS 等不同源的存储),空格分隔。
COMMUNITY_MEDIA_ORIGINS=
# 腾讯云验证码 CaptchaAppId(公开值,可选);留空则用社区服务 /auth/config 给的。构建时写进前端。
NEXT_PUBLIC_TENCENT_CAPTCHA_APP_ID=
# 用户协议 / 隐私政策的版本号(可选):以社区服务 /auth/config 为准,取不到时才用它。
NEXT_PUBLIC_COMMUNITY_TERMS_VERSION=
