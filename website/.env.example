# Public GA4 Measurement ID. Leave empty to omit Google Analytics entirely.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-YDRX2Y5WZS

# Search-engine site verification codes (meta tags). Leave empty to omit the tag.
# Each value is the content string the webmaster console gives you, not the whole <meta> tag.
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BAIDU=
SITE_VERIFICATION_BING=
SITE_VERIFICATION_360=
SITE_VERIFICATION_SOGOU=

# MosaelCloud 的内部地址(官网把 /api/cloud/v1/* 同源反代给它)。生产用 compose 里的服务名,
# 例如 http://cloud:8000;本地开发默认 http://127.0.0.1:8901。
CLOUD_API_URL=http://127.0.0.1:8901
