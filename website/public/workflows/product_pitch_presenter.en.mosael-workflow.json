        "position": {
          "x": 650,
          "y": 800
        },
        "config": {
          "entity_id": "",
          "text": "{{pitch_script.json.call_to_action}}",
          "model": ""
        },
        "inputs": [
          "entity_id"
        ]
      },
      {
        "id": "cta_place",
        "type": "timeline_append",
        "name": "Put the call to action last",
        "position": {
          "x": 1290,
          "y": 800
        },
        "config": {
          "sequence_id": "",
          "asset_id": "",
          "track_id": ""
        },
        "inputs": [
          "sequence_id",
          "asset_id",
          "track_id"
        ]
      },
      {
        "id": "shoot_beats",
        "type": "loop_foreach",
        "name": "Paint, voice and place each beat",
        "position": {
          "x": 970,
          "y": 260
        },
        "config": {
          "items": "{{pitch_script.json.beats}}",
          "inputs": {
            "product_asset_id": "{{product_photo.asset_id}}",
            "sequence_id": "{{pitch_project.sequence_id}}",
            "video_track_id": "{{pitch_project.video_track_id}}",
            "audio_track_id": "{{pitch_project.audio_track_id}}",
            "voice_engine": "{{presenter.voice_engine}}",
            "voice_id": "{{presenter.voice_id}}"
          },
          "body": {
            "nodes": [
              {
                "id": "beat_frame",
                "type": "ai_generate",
                "name": "Paint this beat",
                "position": {
                  "x": 80,
                  "y": 140
                },
                "config": {
                  "provider": "",
                  "provider_profile_id": "",
                  "model": "",
                  "kind": "image",
                  "prompt": "{{loop.item.visual_prompt}} The product in the reference image must be reproduced EXACTLY: identical cut, silhouette, colour, fabric texture, weave, print scale and placement, stitching, buttons, trims and any logo or label. Do not redesign, restyle, recolour, resize the print, add or remove details. Only the wearer, pose, setting and lighting may change. Vertical composition for a phone screen, photorealistic, no text, no logo overlay, no watermark.",
                  "negative_prompt": "different garment, altered pattern, changed colour, distorted print, redesigned collar or sleeves, extra logos, text, watermark, deformed hands, extra limbs",
                  "parameters": {},
                  "source_assets": [
                    "{{input.product_asset_id}}:reference_image"
                  ]
                }
              },
              {
                "id": "beat_on_timeline",
                "type": "timeline_append",
                "name": "Lay it down for this beat's length",
                "position": {
                  "x": 400,
                  "y": 140
                },
                "config": {
                  "sequence_id": "{{input.sequence_id}}",
                  "asset_id": "",
                  "track_id": "{{input.video_track_id}}",
                  "start": 0,
                  "end": "{{loop.item.seconds}}"
                },
                "inputs": [
                  "asset_id"
                ]
              },
              {
                "id": "beat_voice",
                "type": "synthesize_speech",
                "name": "Voice this beat",
                "position": {
                  "x": 400,
                  "y": 320
                },
                "config": {
                  "text": "{{loop.item.narration}}",
                  "engine": "{{input.voice_engine}}",
                  "voice": "{{input.voice_id}}"
                }
              },
              {
                "id": "beat_voice_place",
                "type": "timeline_append",
                "name": "Line the voice up with the beat",
                "position": {
                  "x": 720,
                  "y": 320
                },
                "config": {
                  "sequence_id": "{{input.sequence_id}}",
                  "asset_id": "",
                  "track_id": "{{input.audio_track_id}}",
                  "at": "",
                  "max_duration": "{{loop.item.seconds}}"
                },
                "inputs": [
                  "asset_id",
                  "at"
                ]
              }
            ],
            "edges": [
              {
                "id": "d-beat_frame-asset_id-beat_on_timeline-asset_id",
                "source": "beat_frame",
                "target": "beat_on_timeline",
                "kind": "data",
                "source_output": "asset_id",
                "target_input": "asset_id"
              },
              {
                "id": "d-beat_voice-asset_id-beat_voice_place-asset_id",
                "source": "beat_voice",
                "target": "beat_voice_place",
                "kind": "data",
                "source_output": "asset_id",
                "target_input": "asset_id"
              },
              {
                "id": "d-beat_on_timeline-timeline_start-beat_voice_place-at",
                "source": "beat_on_timeline",
                "target": "beat_voice_place",
                "kind": "data",
                "source_output": "timeline_start",
                "target_input": "at"
              }
            ]
          },
          "concurrency": 1,
          "output": ""
        }
      },
      {
        "id": "beat_captions",
        "type": "generate_subtitles",
        "name": "Lay each beat's on-screen line",
        "position": {
          "x": 1290,
          "y": 260
