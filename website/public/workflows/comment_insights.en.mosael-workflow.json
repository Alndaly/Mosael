        "config": {
          "template": "{{dy_comments_m.summary}}{{xhs_comments_m.summary}}{{bili_comments_m.summary}}{{web_comments_m.summary}}\n\n### All comments (by likes)\n\n{{dy_comments_m.table}}{{xhs_comments_m.table}}{{bili_comments_m.table}}{{web_comments_m.table}}"
        }
