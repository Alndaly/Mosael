      {
        "id": "no_comments_notice",
        "type": "notify",
        "name": "No comments fetched",
        "position": {
          "x": 3240,
          "y": 858
        },
        "config": {
          "title": "Comment insights stopped: no comments were fetched",
          "body": "No comments came back for {{link.url}}. Usual causes: comments need a sign-in (always on Xiaohongshu — switch “Open in the built-in browser” to a signed-in browser-pool profile); comments are off or there are none yet; the TikHub tools aren't enabled or the quota ran out. {{web_struct.json.notes}}"
        }
      },
      {
        "id": "insight",
        "type": "llm",
        "name": "Analyse the comments",
        "position": {
          "x": 3240,
          "y": 535
        },
        "config": {
          "profile_id": "",
          "model": "",
          "preset": "precise",
          "system": "你是用户研究和社区运营专家。你会收到一条作品下赞最多的一批评论(按赞排好,赞数写在前面)。做评论区洞察。\n\n- verdict:一句话,评论区最值得注意的事。\n- report_markdown 用二级标题分成这几节:\n  1. 大家在聊什么:按话题聚类,每类写条数和 1–2 条代表评论原文;\n  2. 观众画像:从用词、关心的事推断年龄段、身份、所处阶段,每一条写明依据,并注明是推断;\n  3. 需求与痛点;\n  4. 疑问清单:大家在问什么,哪些值得单独做一条内容回答;\n  5. 异议与负面:说了什么、有多少、建议怎么回应;\n  6. 情绪分布:正面 / 中性 / 负面的大致比例(注明是估计);\n  7. 下一条可以做什么:3–5 个选题,每个写清依据的是哪几条评论。\n- reply_suggestions_markdown:挑 5–10 条最值得回复的评论(高赞的问题、误解、负面),写出建议回复,语气真诚、不抬杠。\n- 只引用给到的评论原文,不要编评论;样本少就明说结论的把握有限。\n- 用户写了关心的问题就单独一节回应。\n- 用{{start.report_language}}写。\n只输出符合 JSON Schema 的对象。",
          "prompt": "作品:{{link.url}}\n平台:{{link.platform}}\n标题(可能为空):{{web_struct.json.title}}\n用户关心的问题(可能为空):{{start.focus}}\n\n{{data_block.text}}",
          "response_format": "json_schema",
          "json_schema_name": "comment_insights",
          "json_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "笔记标题:带上作品标题和「评论区洞察」"
              },
              "verdict": {
                "type": "string",
                "description": "一句话:评论区最值得注意的事"
              },
              "report_markdown": {
                "type": "string",
                "description": "完整洞察,Markdown"
              },
              "reply_suggestions_markdown": {
                "type": "string",
                "description": "值得回复的评论与建议回复,Markdown"
              }
            },
            "required": [
              "title",
              "verdict",
              "report_markdown",
              "reply_suggestions_markdown"
            ],
            "additionalProperties": false
          },
          "json_schema_strict": "true",
          "temperature": 0.3,
          "max_tokens": 12000
        }
      },
      {
        "id": "save_note",
        "type": "note_create",
        "name": "Save as a note",
        "position": {
          "x": 3560,
          "y": 535
        },
        "config": {
          "title": "{{insight.json.title}}",
          "markdown": "> {{insight.json.verdict}}\n\n{{insight.json.report_markdown}}\n\n## Suggested replies\n\n{{insight.json.reply_suggestions_markdown}}\n\n---\n\n## Appendix: the comments\n\n{{data_block.text}}",
          "tags": "comment insights"
        }
      },
      {
        "id": "done_notice",
        "type": "notify",
        "name": "Insights ready",
        "position": {
          "x": 3880,
          "y": 535
        },
        "config": {
          "title": "The comment insights are saved as a note",
          "body": "{{insight.json.verdict}}"
        }
      },
      {
        "id": "output",
        "type": "output",
        "name": "Hand over the insights and replies",
        "position": {
          "x": 4200,
          "y": 535
        },
        "config": {
          "values": {
            "note_id": "{{save_note.note_id}}",
            "verdict": "{{insight.json.verdict}}",
            "report": "{{insight.json.report_markdown}}",
            "replies": "{{insight.json.reply_suggestions_markdown}}"
          }
        }
      }
    ],
