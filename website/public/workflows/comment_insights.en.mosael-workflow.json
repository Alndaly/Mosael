      {
        "id": "web_read",
        "type": "browser_evaluate",
        "name": "Scroll and read the page text",
        "position": {
          "x": 1640,
          "y": 858
        },
        "config": {
          "session": "",
          "expression": "(async () => {\n  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n  await wait(Number(input.settle_ms) || 2500);\n  const rounds = Math.min(Number(input.scrolls) || 0, 10);\n  for (let i = 0; i < rounds; i += 1) {\n    window.scrollBy(0, Math.max(window.innerHeight, 800));\n    await wait(Number(input.pause_ms) || 1200);\n  }\n  const parts = [(document.body && document.body.innerText) || \"\"];\n  const visit = (root) => {\n    root.querySelectorAll(\"*\").forEach((el) => {\n      if (!el.shadowRoot) return;\n      const text = Array.from(el.shadowRoot.children).map((one) => one.innerText || \"\").join(\"\\n\").trim();\n      if (text) parts.push(text);\n      visit(el.shadowRoot);\n    });\n  };\n  visit(document);\n  const limit = Number(input.max_chars) || 30000;\n  return { url: location.href, title: document.title, now: new Date().toISOString(), text: parts.join(\"\\n\\n\").slice(0, limit) };\n})()",
          "input": {
            "settle_ms": 2500,
            "scrolls": 10,
            "pause_ms": 1200,
            "max_chars": 50000
          }
        },
        "inputs": [
          "session"
        ]
      },
      {
        "id": "web_close",
        "type": "browser_close",
        "name": "Close the browser",
        "position": {
          "x": 1960,
          "y": 1010
        },
        "config": {
          "session": ""
        },
        "inputs": [
          "session"
        ]
      },
      {
        "id": "web_struct",
        "type": "llm",
        "name": "Turn the page text into a comment list",
        "position": {
          "x": 1960,
          "y": 858
        },
        "config": {
          "profile_id": "",
          "model": "",
          "preset": "precise",
          "system": "你会收到内嵌浏览器打开一条自媒体作品、往下滚过评论区之后读到的页面文字。把这条作品的标题和页面上能看到的每一条评论整理出来(原文一字不改,赞多的优先,最多 150 条;回复楼里的也算,但不要把推荐视频的标题当成评论)。\n规则:\n- 只抄页面上真有的,不编、不补、不估;页面上没有的字段写空字符串。\n- 数字照页面原样抄(1.2万、3.4w、10万+ 都原样写),不要自己换算。\n- 发布时间:能确定就写成 YYYY-MM-DD(有钟点就 YYYY-MM-DD HH:MM);写的是相对时间(3天前、昨天、2小时前)就按\n  「读取时间」换算成日期;只写了月-日(09-21)就补上读取时间那一年;实在看不出就空字符串。\n- 页面主要是登录框、验证码、「登录后查看更多」时 login_wall = true,并在 notes 里说清看到了什么;\n  这时宁可少抄,不要把推荐位、广告、别人的作品当成这个账号的。\n只输出符合 JSON Schema 的对象。",
          "prompt": "平台(可能为空):{{link.platform}}\n作品:{{link.url}}\n读取时间:{{web_read.value.now}}\n页面标题:{{web_read.value.title}}\n\n页面文字:\n{{web_read.value.text}}",
          "response_format": "json_schema",
          "json_schema_name": "comments_page",
          "json_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "这条作品的标题"
              },
              "comments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "评论原文,一字不改"
                    },
                    "likes": {
                      "type": "string",
                      "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                    },
                    "author": {
                      "type": "string"
                    },
                    "published_at": {
                      "type": "string",
                      "description": "能看出就写 YYYY-MM-DD,否则空字符串"
                    }
                  },
                  "required": [
                    "text",
                    "likes",
                    "author",
                    "published_at"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 150
              },
              "login_wall": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "description": "页面上异常的地方;没有就空字符串"
              }
            },
            "required": [
              "title",
              "comments",
              "login_wall",
              "notes"
            ],
            "additionalProperties": false
          },
          "json_schema_strict": "true",
          "temperature": 0.1,
          "max_tokens": 16000
        }
      },
      {
        "id": "web_comments_m",
