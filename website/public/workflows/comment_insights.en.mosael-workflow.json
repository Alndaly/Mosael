                "description": "笔记标题:带上作品标题和「评论区洞察」"
              },
              "verdict": {
                "type": "string",
                "description": "一句话:评论区最值得注意的事"
              },
              "report_markdown": {
                "type": "string",
                "description": "完整洞察,Markdown"
              },
              "reply_suggestions_markdown": {
                "type": "string",
                "description": "值得回复的评论与建议回复,Markdown"
              }
            },
            "required": [
              "title",
              "verdict",
              "report_markdown",
              "reply_suggestions_markdown"
            ],
            "additionalProperties": false
          },
          "json_schema_strict": "true",
          "temperature": 0.3,
          "max_tokens": 12000
        }
      },
      {
        "id": "save_note",
        "type": "note_create",
        "name": "Save as a note",
        "position": {
