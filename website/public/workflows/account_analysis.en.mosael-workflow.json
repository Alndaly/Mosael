        "config": {
          "profile_id": "",
          "model": "",
          "preset": "precise",
          "system": "你会收到内嵌浏览器打开一个自媒体账号主页后读到的页面文字,里面可能夹着导航、推荐、登录提示。把这个账号的资料和页面上能看到的每一条作品整理出来。\n规则:\n- 只抄页面上真有的,不编、不补、不估;页面上没有的字段写空字符串。\n- 数字照页面原样抄(1.2万、3.4w、10万+ 都原样写),不要自己换算。\n- 发布时间:能确定就写成 YYYY-MM-DD(有钟点就 YYYY-MM-DD HH:MM);写的是相对时间(3天前、昨天、2小时前)就按\n  「读取时间」换算成日期;只写了月-日(09-21)就补上读取时间那一年;实在看不出就空字符串。\n- 页面主要是登录框、验证码、「登录后查看更多」时 login_wall = true,并在 notes 里说清看到了什么;\n  这时宁可少抄,不要把推荐位、广告、别人的作品当成这个账号的。\n只输出符合 JSON Schema 的对象。",
          "prompt": "平台(可能为空):{{link.platform}}\n主页:{{link.url}}\n读取时间:{{web_read.value.now}}\n页面标题:{{web_read.value.title}}\n\n页面文字:\n{{web_read.value.text}}",
          "response_format": "json_schema",
          "json_schema_name": "account_page",
          "json_schema": {
            "type": "object",
            "properties": {
              "account": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "handle": {
                    "type": "string",
                    "description": "平台上的账号 / 号码"
                  },
                  "bio": {
                    "type": "string"
                  },
                  "followers": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "following": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "likes_total": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "posts_total": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  }
                },
                "required": [
                  "name",
                  "handle",
                  "bio",
                  "followers",
                  "following",
                  "likes_total",
                  "posts_total"
                ],
                "additionalProperties": false
              },
              "posts": {
                "type": "array",
                "items": {
