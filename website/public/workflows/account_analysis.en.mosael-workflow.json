                    "title": {
                      "type": "string",
                      "description": "标题或文案的开头"
                    },
                    "published_at": {
                      "type": "string",
                      "description": "发布时间,写成 YYYY-MM-DD 或 YYYY-MM-DD HH:MM;看不出就空字符串"
                    },
                    "duration": {
                      "type": "string",
