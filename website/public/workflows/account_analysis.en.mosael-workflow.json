      {
        "id": "no_posts_notice",
        "type": "notify",
        "name": "No posts fetched",
        "position": {
          "x": 3240,
          "y": 820
        },
        "config": {
          "title": "Account analysis stopped: no posts were fetched",
          "body": "No posts came back for {{link.url}}. Usual causes: the page needs a sign-in (Xiaohongshu always, Douyin mostly — switch “Open in the built-in browser” to a signed-in browser-pool profile); the link isn't a profile; the account has no public posts; the TikHub tools aren't enabled or the quota ran out. {{web_struct.json.notes}}"
