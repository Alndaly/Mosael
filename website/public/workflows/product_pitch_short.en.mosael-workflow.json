                  "op": "not_empty"
                }
              },
              {
                "id": "beat_voice",
                "type": "synthesize_speech",
                "name": "Voice this beat",
                "position": {
                  "x": 400,
                  "y": 320
                },
                "config": {
                  "text": "{{loop.item.narration}}",
                  "engine": "builtin:edge",
                  "voice": "zh-CN-XiaoxiaoNeural"
                }
              },
              {
                "id": "beat_voice_place",
                "type": "timeline_append",
                "name": "Line the voice up with the beat",
                "position": {
                  "x": 1040,
                  "y": 320
                },
                "config": {
                  "sequence_id": "{{input.sequence_id}}",
                  "asset_id": "",
                  "track_id": "{{input.audio_track_id}}",
                  "at": "",
                  "max_duration": "",
                  "trim_overflow": "yes"
                },
                "inputs": [
                  "asset_id",
                  "at",
                  "max_duration"
                ]
              },
              {
                "id": "voice_overflow",
                "type": "condition",
                "name": "Was the voice-over cut short?",
                "position": {
                  "x": 1360,
                  "y": 320
                },
                "config": {
                  "left": "",
                  "op": "gt",
                  "right": "0"
                },
                "inputs": [
                  "left"
                ]
              },
              {
                "id": "overflow_notice",
                "type": "notify",
                "name": "Say the voice-over was cut",
                "position": {
                  "x": 1680,
                  "y": 320
                },
                "config": {
                  "title": "Product short: a beat's voice-over didn't fit",
                  "body": "The voice-over for the “{{loop.item.caption}}” beat is still {{beat_voice_place.trimmed}} s longer than its picture at 1.5× speed, so the rest was cut. To keep the whole line, shorten that beat's narration or raise the start node's beat_seconds (to a length the video model can make) and run again."
                }
              }
            ],
            "edges": [
