            ]
          },
          "concurrency": 1,
          "output": ""
        },
        "inputs": [
          "items"
        ]
      },
      {
        "id": "beat_captions",
        "type": "generate_subtitles",
        "name": "Lay each beat's on-screen line",
        "position": {
          "x": 1290,
          "y": 260
        },
        "config": {
          "sequence_id": "",
          "segments": "",
          "start_field": "beat_on_timeline.timeline_start",
          "end_field": "beat_on_timeline.timeline_end",
          "text_field": "loop.item.caption"
        },
        "inputs": [
          "sequence_id",
          "segments"
        ]
      },
      {
        "id": "export_short",
        "type": "export_sequence",
        "name": "Export the short",
        "position": {
          "x": 1610,
          "y": 260
        },
        "config": {
          "sequence_id": ""
        },
        "inputs": [
          "sequence_id"
        ]
      },
      {
        "id": "done_notice",
        "type": "notify",
        "name": "Short is ready",
        "position": {
          "x": 1930,
          "y": 260
        },
        "config": {
          "title": "Product short exported",
          "body": "The narrated short for {{start.product_name}} is done: {{shoot_beats.count}} beats.\n{{shoot_beats.results.0.beat_voice.voice_note}}\n{{fit_beats.note}}"
        }
      },
      {
        "id": "output",
        "type": "output",
        "name": "Hand over the short and the script",
        "position": {
          "x": 2250,
          "y": 260
