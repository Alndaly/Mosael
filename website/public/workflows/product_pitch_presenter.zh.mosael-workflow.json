      "template_id": "product_pitch_presenter",
      "template_version": 2,
      "source": "official"
    },
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "填商品与卖点",
        "position": {
          "x": 40,
          "y": 260
        },
        "config": {
          "params": {
            "product_name": "",
            "selling_points": "",
            "audience": "刷竖屏短视频的年轻观众",
            "target_duration_seconds": 30,
            "width": 1080,
            "height": 1920,
            "fps": 30
          },
          "required_params": "product_name, selling_points"
        }
      },
      {
        "id": "product_photo",
        "type": "asset",
        "name": "选择商品图",
        "position": {
          "x": 330,
          "y": 260
        },
        "config": {
          "asset_id": ""
        }
      },
      {
        "id": "pitch_script",
        "type": "llm",
        "name": "写分拍口播脚本",
        "position": {
          "x": 650,
          "y": 120
        },
        "config": {
          "profile_id": "",
          "model": "",
          "preset": "creative",
          "system": "你是带货短视频的编导。用户给你一件商品和几条卖点，你要写一条 20-45 秒、能直接拍的\n口播脚本，按\"拍\"拆开。\n\n硬性要求：\n- 前三秒必须给出观看理由，不要从\"大家好\"开始。\n- 每一拍的 narration 念出来不能超过这一拍的 seconds：中文按每秒约 4 个字估，宁短勿长。\n- visual_prompt 用英文写这一拍的画面，**商品必须出现在画面里**；不要写机位参数，不要在画面里\n  生成文字、logo 或水印。\n- 卖点只能来自用户给的那几条，不要编造功效、成分、资质或数据。\n- caption 是屏幕上的短句，不是把 narration 原样抄一遍。\n- 最多 12 拍：每一拍都要出一张画面。\n\n只输出符合 JSON Schema 的对象。\n\n这一条由一位主播**出镜**说开场钩子(hook_line)和结尾号召(call_to_action):这两句是对着镜头说的话,\n口语、自然,各自念出来不超过 8 秒;它们**也算在成片时长里**。中间的每一拍是商品画面,narration 是画外音。",
          "prompt": "商品名称：{{start.product_name}}\n卖点（只能用这些）：\n{{start.selling_points}}\n目标观众：{{start.audience}}\n成片目标时长：{{start.target_duration_seconds}} 秒\n\n请写出分拍脚本。各拍 seconds 之和，加上开场钩子和结尾号召念出来的时长（中文每秒约 4 个字），要接近目标时长。",
          "response_format": "json_schema",
          "json_schema_name": "product_pitch_script",
          "json_schema": {
            "type": "object",
            "properties": {
              "hook_line": {
                "type": "string",
                "description": "主播出镜说的开场钩子,中文,念出来不超过 8 秒"
              },
              "beats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "narration": {
                      "type": "string",
                      "description": "这一拍要念的口播原文,中文;念出来不超过本拍时长"
                    },
                    "seconds": {
                      "type": "number",
                      "minimum": 2,
                      "maximum": 8,
                      "description": "这一拍多长"
                    },
                    "visual_prompt": {
                      "type": "string",
                      "description": "这一拍的画面,英文;商品必须在画面里"
                    },
                    "caption": {
                      "type": "string",
                      "description": "屏幕上的短句,不超过 14 字"
                    }
                  },
                  "required": [
                    "narration",
                    "seconds",
                    "visual_prompt",
                    "caption"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 12
              },
              "call_to_action": {
                "type": "string",
                "description": "主播出镜说的结尾行动号召,中文,念出来不超过 8 秒"
              }
            },
            "required": [
              "hook_line",
              "beats",
              "call_to_action"
            ],
            "additionalProperties": false
          },
          "json_schema_strict": "true",
          "temperature": 0.6,
          "max_tokens": 6000
        }
      },
      {
