                "description": "页面上异常的地方;没有就空字符串"
              }
            },
            "required": [
              "video",
              "comments",
              "login_wall",
              "notes"
            ],
            "additionalProperties": false
          },
          "json_schema_strict": "true",
          "temperature": 0.1,
          "max_tokens": 12000
        }
      },
