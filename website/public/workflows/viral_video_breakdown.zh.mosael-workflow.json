      {
        "id": "web_struct",
        "type": "llm",
        "name": "把页面文字抄成视频数据和评论",
        "position": {
          "x": 1960,
          "y": 858
        },
        "config": {
          "profile_id": "",
          "model": "",
          "preset": "precise",
          "system": "你会收到内嵌浏览器打开一条自媒体视频 / 笔记后读到的页面文字(往下滚过,评论区可能在里面)。把这条视频的数据和页面上能看到的评论整理出来(评论原文一字不改,最多 80 条,赞多的优先)。\n规则:\n- 只抄页面上真有的,不编、不补、不估;页面上没有的字段写空字符串。\n- 数字照页面原样抄(1.2万、3.4w、10万+ 都原样写),不要自己换算。\n- 发布时间:能确定就写成 YYYY-MM-DD(有钟点就 YYYY-MM-DD HH:MM);写的是相对时间(3天前、昨天、2小时前)就按\n  「读取时间」换算成日期;只写了月-日(09-21)就补上读取时间那一年;实在看不出就空字符串。\n- 页面主要是登录框、验证码、「登录后查看更多」时 login_wall = true,并在 notes 里说清看到了什么;\n  这时宁可少抄,不要把推荐位、广告、别人的作品当成这个账号的。\n只输出符合 JSON Schema 的对象。",
          "prompt": "平台(可能为空):{{link.platform}}\n视频:{{link.url}}\n读取时间:{{web_read.value.now}}\n页面标题:{{web_read.value.title}}\n\n页面文字:\n{{web_read.value.text}}",
          "response_format": "json_schema",
          "json_schema_name": "video_page",
          "json_schema": {
            "type": "object",
            "properties": {
              "video": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "标题或文案的开头"
                  },
                  "published_at": {
                    "type": "string",
                    "description": "发布时间,写成 YYYY-MM-DD 或 YYYY-MM-DD HH:MM;看不出就空字符串"
                  },
                  "duration": {
                    "type": "string",
                    "description": "时长,写成 mm:ss 或秒数;没有就空字符串"
                  },
                  "views": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "likes": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "comments": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "collects": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "shares": {
                    "type": "string",
                    "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                  },
                  "author": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "description": "简介 / 文案 / 话题标签"
                  }
                },
                "required": [
                  "title",
                  "published_at",
                  "duration",
                  "views",
                  "likes",
                  "comments",
                  "collects",
                  "shares",
                  "author",
                  "description"
                ],
                "additionalProperties": false
              },
              "comments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "评论原文,一字不改"
                    },
                    "likes": {
                      "type": "string",
                      "description": "照页面原样抄(如 1.2万、3456、10万+);页面上没有就空字符串"
                    },
                    "author": {
                      "type": "string"
                    },
                    "published_at": {
                      "type": "string",
                      "description": "能看出就写 YYYY-MM-DD,否则空字符串"
                    }
                  },
                  "required": [
                    "text",
                    "likes",
                    "author",
                    "published_at"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 80
              },
              "login_wall": {
