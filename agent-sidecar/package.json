{
  "name": "@open-studio/agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Open Studio AI agent sidecar — embeds the pi coding agent (pi-agent-core) and speaks newline-delimited JSON over stdio with the Python backend.",
  "type": "module",
  "main": "dist/sidecar.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/sidecar.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.80.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
