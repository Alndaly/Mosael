# MosaelCloud 的环境变量。复制成 .env 再改;生产不要用这里的任何值。

# 数据目录(SQLite 与运行数据)。
CLOUD_DATA_DIR=./cloud-data

# 官网的公开原点(没有结尾斜杠)。设备授权的验证页、同源校验都按它拼。
CLOUD_PUBLIC_URL=http://localhost:3000

# 生产数据库。留空 = CLOUD_DATA_DIR 下的 SQLite。
CLOUD_DATABASE_URL=

# 生产必须是 true;本地 http 开发设 false。
CLOUD_COOKIE_SECURE=false

# 登录会话、设备码与轮询。
CLOUD_SESSION_TTL_DAYS=30
CLOUD_DEVICE_CODE_TTL_SECONDS=600
CLOUD_DEVICE_POLL_INTERVAL_SECONDS=5

# 官方发布账号(seed-official 用;它也是一个可以登录的运营账号)。
# 短名 / 邮箱只在第一次建号时使用;密码设了则每次种子都写回。这里不要填真实密码。
CLOUD_OFFICIAL_HANDLE=
CLOUD_OFFICIAL_EMAIL=
CLOUD_OFFICIAL_PASSWORD=

# 可选 TOTP 双因素的 secret 加密钥(Fernet)。空 = 用户不能开启 MFA;已开启的账号会验证失败。
# 生成:`uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
CLOUD_MFA_KEY=

# 腾讯云短信(手机验证码登录)。五项齐了才启用;模板只接受 {1}=验证码,参数个数必须与模板一致。
# SecretId/SecretKey 建议用只授短信发送权限的 CAM 子账号。
CLOUD_TENCENT_SMS_SECRET_ID=
CLOUD_TENCENT_SMS_SECRET_KEY=
CLOUD_TENCENT_SMS_SDK_APP_ID=
CLOUD_TENCENT_SMS_SIGN_NAME=
CLOUD_TENCENT_SMS_TEMPLATE_ID=
CLOUD_TENCENT_SMS_REGION=ap-guangzhou

# 官方中转网关:上游 API Key 的落库加密钥。`uv run python -m cloud.cli channel-key` 生成;不填 = 网关对话回 503。
CLOUD_CHANNEL_KEY=
