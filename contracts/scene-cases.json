          "t": 1,
          "layers": [
            {
              "clip": "cBase",
              "track": "base",
              "isBase": true
            },
            {
              "clip": "cOver",
              "track": "over",
              "isBase": false
            }
          ]
        },
        {
          "t": 6,
          "why": "base 已结束:只剩上层,而且它**不会**因此变成 base(取景不能突然改变)。",
          "layers": [
            {
              "clip": "cOver",
              "track": "over",
              "isBase": false
            }
          ]
        }
      ]
    },
    {
      "name": "clip-boundary-is-half-open",
      "why": "区间是 [start, end):交界处只有后一个片段命中。两侧若一开一闭,切换帧会画两层或一层都不画(曾表现为切换处闪黑)。",
      "assets": {
        "a": {
          "kind": "video"
        }
      },
      "tracks": [
        {
          "id": "t0",
          "kind": "video",
          "position": 0,
          "muted": false,
          "clips": [
            {
              "id": "first",
              "asset_id": "a",
              "timeline_start": 0,
              "src_in": 0,
              "src_out": 2,
              "speed": 1
