    {
      "name": "overlay-outlives-base",
      "why": "回归:上层比底轨长时,超出部分不能被截断。总时长取所有画面轨的最大结束点,不是 base 轨的。",
      "assets": {
        "a": {
          "kind": "video"
        }
      },
      "tracks": [
        {
          "id": "over",
          "kind": "video",
          "position": 0,
          "muted": false,
          "clips": [
            {
              "id": "cOver",
              "asset_id": "a",
              "timeline_start": 0,
              "src_in": 0,
              "src_out": 9,
              "speed": 1
