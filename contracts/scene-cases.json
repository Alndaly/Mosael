    {
      "name": "empty-bottom-track-is-not-base",
      "why": "回归:base 必须是最底「有画面片段」的轨。取字面最底轨会让导出变成「无片段可渲染」,或让预览把上层降级成 overlay 而丢掉 fill_mode 取景。",
      "assets": {
        "a": {
          "kind": "video"
        }
      },
      "tracks": [
        {
          "id": "hasMedia",
          "kind": "video",
          "position": 0,
