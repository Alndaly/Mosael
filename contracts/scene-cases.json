        {
          "t": 2,
          "layers": [
            {
              "clip": "second",
              "track": "t0",
              "isBase": true
            }
          ]
        }
      ]
    },
    {
      "name": "speed-shortens-timeline-span",
      "why": "时间线时长 = 源区间 / 速度。两侧算法必须一致,否则 2 倍速片段的结束点会差一半。",
