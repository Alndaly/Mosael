        "textAny": [
          "短信登录",
          "上传视频",
          "发布笔记"
        ],
        "urlAny": [
          "creator.xiaohongshu.com"
        ]
      },
      "limits": {
        "titleMax": 20,
        "imageMax": 18,
        "bodyMax": 1000
      }
    },
