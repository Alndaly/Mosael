              "text": "都很"
            },
            {
              "start_time": 4.2,
              "end_time": 5.9,
              "text": "熟悉"
            }
          ]
        }
      ],
      "expected": [
        {
          "id": "s:0",
          "start_time": 0.0,
          "end_time": 2.6,
          "text": "我们今天要讲的这个话题非常重要,"
        },
        {
          "id": "s:1",
          "start_time": 2.6,
          "end_time": 6.0,
          "text": "其实大家都很熟悉"
        }
      ]
    },
    {
      "name": "eight-seconds-is-the-longest-line",
      "why": "一行满 8 秒就断,哪怕一直没停顿、没标点。",
      "segments": [
        {
          "id": "l",
          "start_time": 0.0,
          "end_time": 12.0,
          "text": "a b c d e f",
          "tokens": [
            {
              "start_time": 0.0,
              "end_time": 2.0,
              "text": "a"
            },
            {
              "start_time": 2.0,
              "end_time": 4.0,
              "text": "b"
            },
            {
