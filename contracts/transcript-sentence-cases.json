          "end_time": 12.0,
          "text": "e f"
        }
      ]
    },
    {
      "name": "no-word-timings-split-by-sentence-proportionally",
      "why": "没有词级时间戳:按句末标点切,时间按显示单位数按比例分。中文句号后不必有空格。",
      "segments": [
        {
          "id": "f",
          "start_time": 0.0,
          "end_time": 9.0,
          "text": "第一句话。第二句！Third one. Fourth",
          "tokens": []
        }
      ],
      "expected": [
        {
          "id": "f:0",
          "start_time": 0.0,
          "end_time": 2.612903,
          "text": "第一句话。"
        },
        {
          "id": "f:1",
          "start_time": 2.612903,
          "end_time": 4.645161,
          "text": "第二句！"
        },
        {
          "id": "f:2",
          "start_time": 4.645161,
          "end_time": 7.258065,
          "text": "Third one."
        },
        {
          "id": "f:3",
          "start_time": 7.258065,
          "end_time": 9.0,
          "text": "Fourth"
        }
      ]
    },
    {
      "name": "a-decimal-point-is-not-a-sentence-end",
      "why": "ASCII 句号后面要有空白才算句末 —— 3.5 不切开。",
      "segments": [
        {
          "id": "d",
          "start_time": 0.0,
          "end_time": 4.0,
          "text": "It costs 3.5 dollars. Then more",
          "tokens": []
        }
      ],
      "expected": [
        {
          "id": "d:0",
          "start_time": 0.0,
          "end_time": 2.769231,
          "text": "It costs 3.5 dollars."
        },
        {
          "id": "d:1",
          "start_time": 2.769231,
          "end_time": 4.0,
          "text": "Then more"
        }
      ]
    },
    {
      "name": "one-sentence-keeps-the-paragraph",
      "why": "只有一句:原样一行,文本用段落原文。",
      "segments": [
        {
          "id": "o",
          "start_time": 1.0,
          "end_time": 2.0,
          "text": "嗯 好的",
          "tokens": [
            {
              "start_time": 1.0,
              "end_time": 1.3,
              "text": "嗯"
            },
            {
              "start_time": 1.4,
              "end_time": 1.9,
              "text": "好的"
            }
          ]
