{
  "contract": "transcript-sentences",
  "version": 1,
  "readme": "contracts/README.md",
  "description": "转写段落切成「一句一行」的规则:剪辑台的逐字稿 / 生成字幕(前端 transcriptSegmentsForEditing)和工作流的生成字幕(后端 voices/sentences.sentences_for_editing)必须切得一样。后端 tests/test_transcript_sentence_parity.py 与前端 transcriptProjection.parity.test.ts 跑同一份语料。时间保留 6 位小数比较。",
  "cases": [
    {
      "name": "punctuation-restored-from-paragraph-text",
      "why": "引擎的词级时间戳里没有标点:先把段落原文的标点补回词上,再按句末标点断。",
      "segments": [
        {
          "id": "p",
          "start_time": 0.0,
          "end_time": 4.0,
          "text": "你好。今天天气不错!",
          "tokens": [
            {
              "start_time": 0.0,
              "end_time": 0.4,
              "text": "你"
            },
            {
              "start_time": 0.4,
              "end_time": 0.8,
              "text": "好"
            },
            {
              "start_time": 1.0,
              "end_time": 1.5,
              "text": "今天"
            },
            {
              "start_time": 1.5,
              "end_time": 2.2,
              "text": "天气"
            },
            {
              "start_time": 2.2,
              "end_time": 3.8,
              "text": "不错"
            }
          ]
        }
      ],
      "expected": [
        {
          "id": "p:0",
          "start_time": 0.0,
          "end_time": 0.8,
          "text": "你好。"
        },
        {
          "id": "p:1",
          "start_time": 1.0,
          "end_time": 4.0,
          "text": "今天天气不错!"
        }
      ]
    },
    {
      "name": "english-spaces-and-a-long-pause",
      "why": "英文的空格要补回去;停顿 ≥ 0.75 秒断一行,即使没有标点。",
      "segments": [
        {
          "id": "e",
          "start_time": 10.0,
          "end_time": 16.0,
          "text": "so we went home and then we slept",
          "tokens": [
            {
              "start_time": 10.0,
              "end_time": 10.3,
              "text": "so"
            },
            {
              "start_time": 10.3,
              "end_time": 10.5,
              "text": "we"
            },
            {
              "start_time": 10.5,
              "end_time": 10.9,
              "text": "went"
            },
            {
              "start_time": 10.9,
              "end_time": 11.4,
              "text": "home"
            },
            {
              "start_time": 12.5,
              "end_time": 12.8,
              "text": "and"
            },
            {
              "start_time": 12.8,
              "end_time": 13.1,
              "text": "then"
            },
            {
              "start_time": 13.1,
              "end_time": 13.3,
              "text": "we"
            },
            {
              "start_time": 13.3,
              "end_time": 15.9,
              "text": "slept"
            }
          ]
        }
      ],
      "expected": [
        {
          "id": "e:0",
          "start_time": 10.0,
          "end_time": 11.4,
          "text": "so we went home"
        },
        {
          "id": "e:1",
          "start_time": 12.5,
          "end_time": 16.0,
          "text": "and then we slept"
        }
      ]
    },
    {
      "name": "soft-break-at-a-comma-once-the-line-is-long",
      "why": "满 28 个显示单位(中文字算 2)且遇到逗号类标点就断。",
      "segments": [
        {
          "id": "s",
          "start_time": 0.0,
          "end_time": 6.0,
          "text": "我们今天要讲的这个话题非常重要,其实大家都很熟悉",
          "tokens": [
            {
              "start_time": 0.0,
              "end_time": 0.5,
              "text": "我们"
            },
            {
              "start_time": 0.5,
              "end_time": 1.0,
              "text": "今天"
            },
            {
              "start_time": 1.0,
              "end_time": 1.4,
              "text": "要讲"
            },
            {
              "start_time": 1.4,
              "end_time": 1.6,
              "text": "的"
            },
            {
              "start_time": 1.6,
              "end_time": 2.0,
              "text": "这个"
            },
            {
              "start_time": 2.0,
