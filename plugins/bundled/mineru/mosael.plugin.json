{
  "id": "dev.mosael.mineru",
  "manifest_version": 1,
  "name": {
    "zh": "MinerU 文档解析",
    "en": "MinerU document parsing"
  },
  "default_locale": "zh",
  "version": "1.0.0",
  "author": {
    "name": "Mosael",
    "url": "https://mosael.com"
  },
  "homepage": "https://github.com/Alndaly/Mosael/tree/main/plugins/bundled/mineru",
  "docs": {
    "zh": "https://mosael.com/zh/plugins/mineru",
    "en": "https://mosael.com/en/plugins/mineru"
  },
  "runtime": {
    "kind": "process",
    "entry": "tools/main.py"
  },
  "permissions": [
    "network:mineru"
  ],
  "provides": [
    "document_parse"
  ],
  "skills": [
    {
      "id": "mineru",
      "description": {
        "zh": "把 PDF、Word、PPT、Excel 和图片交给 MinerU(mineru.net)解析成 Markdown:版面分析、OCR、表格和公式识别,扫描件和复杂排版比本地解析强。在「设置 → 能力提供方 → 文档解析」里选它,或在文档详情里「用 MinerU 解析」。文档会上传到 MinerU。",
        "en": "Parse PDF, Word, PowerPoint, Excel and images into Markdown with MinerU (mineru.net): layout analysis, OCR, tables and formulas — much better than local parsing on scans and complex layouts. Choose it under Settings → Capability providers → Document parsing, or use “Parse with MinerU” on a document. Documents are uploaded to MinerU."
      }
    }
  ],
  "instance": {
    "config": [
      {
        "key": "MINERU_MODEL",
        "label": {
          "zh": "模型",
          "en": "Model"
        },
        "type": "enum",
        "default": "vlm",
        "options": [
          {
            "value": "vlm",
            "label": {
              "zh": "VLM(推荐,版面和表格更准)",
              "en": "VLM (recommended: better layout and tables)"
            }
          },
          {
            "value": "pipeline",
            "label": {
              "zh": "Pipeline(经典流水线)",
              "en": "Pipeline (classic)"
            }
          }
        ]
      },
      {
        "key": "MINERU_LANGUAGE",
        "label": {
          "zh": "文档语言",
          "en": "Document language"
        },
        "type": "string",
        "default": "ch",
        "help": {
          "zh": "OCR 用的语言代码:ch(中英混排)、en、japan、korean……",
          "en": "OCR language code: ch (Chinese and English), en, japan, korean…"
        }
      },
      {
        "key": "MINERU_OCR",
        "label": {
          "zh": "强制 OCR",
          "en": "Force OCR"
        },
        "type": "enum",
        "default": "no",
        "options": [
          {
            "value": "no",
            "label": {
              "zh": "否(有文字层就直接读)",
              "en": "No (read the text layer when there is one)"
            }
          },
          {
            "value": "yes",
            "label": {
              "zh": "是(扫描件、文字层乱码时)",
              "en": "Yes (scans, garbled text layers)"
            }
          }
        ]
      }
    ],
    "credentials": [
      {
        "key": "MINERU_TOKEN",
        "label": {
          "zh": "API Token",
          "en": "API token"
        },
        "required": true,
        "help": {
          "zh": "在 mineru.net 的「API 管理」里创建。免费额度每天有页数上限,单个文件最多 200MB、200 页。",
          "en": "Create one under API management on mineru.net. The free tier has a daily page quota; a file can be up to 200 MB and 200 pages."
        }
      }
    ]
  },
  "tools": {
    "expose": "all",
    "declare": [
      {
        "name": "mineru_parse",
        "label": {
          "zh": "用 MinerU 解析文档",
          "en": "Parse a document with MinerU"
        },
        "description": {
          "zh": "把一份文档交给 MinerU 解析成 Markdown(按页标出,表格、公式、插图都保留)。宿主在解析任务里调它,不单独出现在工具表里。",
          "en": "Parse a document into Markdown with MinerU (marked page by page, keeping tables, formulas and images). The host calls it inside a parse job; it isn't listed as a standalone tool."
        },
        "effects": "external",
        "provides": [
          "document_parse"
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": {
                "zh": "要解析的文件(宿主给的本地副本)。",
                "en": "The file to parse (a local copy from the host)."
              }
            },
            "filename": {
              "type": "string",
              "description": {
                "zh": "原文件名。",
                "en": "The original file name."
              }
            }
          },
          "required": [
            "file"
          ]
        },
        "stream": true,
        "timeout_seconds": 1800
      }
    ]
  }
}
