{
  "id": "dev.mosael.tikhub",
  "manifest_version": 1,
  "name": "TikHub",
  "version": "1.0.1",
  "homepage": "https://docs.tikhub.io/",
  "runtime": {
    "kind": "mcp",
    "transport": "http",
    "url": "https://mcp.tikhub.io/${TIKHUB_PLATFORM}/mcp",
    "headers": {
      "Authorization": "Bearer ${TIKHUB_API_KEY}"
    }
  },
  "permissions": [
    "network:tikhub"
  ],
  "instance": {
    "multiple": true,
    "name_template": "TikHub · {TIKHUB_PLATFORM:label}",
    "config": [
      {
        "key": "TIKHUB_PLATFORM",
        "label": {
          "zh": "平台",
          "en": "Platform"
        },
        "type": "enum",
        "required": true,
        "help": {
          "zh": "一个连接对一个平台端点。要同时用两个平台就建两个连接。",
          "en": "One connection targets one platform endpoint. To use two platforms at once, create two connections."
        },
        "options": [
          {
            "value": "douyin",
            "label": {
              "zh": "抖音",
              "en": "Douyin"
            }
          },
          {
            "value": "tiktok",
            "label": "TikTok"
          },
          {
            "value": "xiaohongshu",
            "label": {
              "zh": "小红书",
              "en": "Xiaohongshu"
            }
          },
          {
            "value": "bilibili",
            "label": {
              "zh": "哔哩哔哩",
              "en": "Bilibili"
            }
          },
          {
            "value": "kuaishou",
            "label": {
              "zh": "快手",
              "en": "Kuaishou"
            }
          },
          {
            "value": "weibo",
            "label": {
              "zh": "微博",
              "en": "Weibo"
            }
          },
          {
            "value": "zhihu",
            "label": {
              "zh": "知乎",
              "en": "Zhihu"
            }
          },
          {
            "value": "instagram",
            "label": "Instagram"
          },
          {
            "value": "youtube",
            "label": "YouTube"
          },
          {
            "value": "twitter",
            "label": "X / Twitter"
          },
          {
            "value": "threads",
            "label": "Threads"
          },
          {
            "value": "linkedin",
            "label": "LinkedIn"
          },
          {
            "value": "reddit",
            "label": "Reddit"
          },
          {
            "value": "wechat",
            "label": {
              "zh": "微信",
              "en": "WeChat"
            }
          },
          {
            "value": "others",
            "label": {
              "zh": "其它平台",
              "en": "Other platforms"
            }
          },
          {
            "value": "tikhub",
            "label": {
              "zh": "TikHub 账户工具",
              "en": "TikHub account tools"
            }
          }
        ]
      }
    ],
    "credentials": [
      {
        "key": "TIKHUB_API_KEY",
        "label": "API Key",
        "help": {
          "zh": "在 https://user.tikhub.io 生成。只注入这个连接,拿不到应用的其它凭据。",
          "en": "Generate one at https://user.tikhub.io. It is injected into this connection only and cannot reach the app's other credentials."
        },
        "secret": true
      }
    ]
  },
  "skills": [
    {
      "id": "tikhub",
      "description": {
        "zh": "读抖音 / TikTok / 小红书 / B站 / 快手等平台的公开数据:作品详情、作者主页与作品列表、关键词搜索、热榜。用于选题调研、对标账号分析、找素材灵感。",
        "en": "Read public data from Douyin / TikTok / Xiaohongshu / Bilibili / Kuaishou and other platforms: post details, creator profiles and their posts, keyword search, trending charts. For topic research, studying comparable accounts, and finding footage ideas."
      }
    }
  ],
  "tools": {
    "expose": "selected",
    "recommended": []
  }
}
