{
  "id": "dev.mosael.text-toolkit",
  "manifest_version": 6,
  "name": "Text Toolkit",
  "summary": {
    "zh": "文本小工具:数字数、断字幕行、截短、清理格式、提取话题和链接,全在本机算。",
    "en": "Small text tools: word counts, subtitle lines, shortening, cleanup, and pulling out hashtags and links, all on this computer."
  },
  "default_locale": "zh",
  "version": "0.3.1",
  "author": {
    "name": "Mosael",
    "url": "https://mosael.com"
  },
  "homepage": "https://github.com/Alndaly/Mosael/tree/main/plugins/examples/text-toolkit",
  "docs": {
    "zh": "https://mosael.com/zh/plugins/text-toolkit",
    "en": "https://mosael.com/en/plugins/text-toolkit"
  },
  "runtime": {
    "kind": "process",
    "entry": "tools/main.py"
  },
  "permissions": [],
  "skills": [
    {
      "id": "text_toolkit",
      "description": {
        "zh": "文本小工具:统计字数与念完要多久,把口播稿断成字幕行,按字数截短,清理文案里多余的空格、空行和半角标点,把 Markdown 转成能直接贴的纯文本,提取 #话题#、网址、@ 提及和邮箱。纯本地计算,无需任何权限。",
        "en": "Small text utilities: count words and read-aloud time, break a script into subtitle lines, shorten text to a length, tidy stray spaces, blank lines and half-width punctuation, turn Markdown into paste-ready plain text, and pull out hashtags, links, @mentions and emails. All local, no permissions needed."
      }
    }
  ],
  "tools": {
    "expose": "all",
    "declare": [
      {
        "name": "word_count",
        "label": {
          "zh": "统计字数",
          "en": "Word count"
        },
        "description": {
          "zh": "统计文本的字数、词数与预计口播时长(中文每秒约 4.5 字,英文每分钟约 150 词)。中日韩文一个字算一个词。",
          "en": "Count characters and words in a text and estimate read-aloud time (about 4.5 Chinese characters a second, 150 English words a minute). Each CJK character counts as a word."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "chars",
            "words",
            "estimated_seconds",
            "summary"
          ],
          "output_types": {
            "chars": "number",
            "words": "number",
            "estimated_seconds": "number",
            "summary": "text"
          },
          "output_labels": {
            "chars": {
              "zh": "字数",
              "en": "Characters"
            },
            "words": {
              "zh": "词数",
              "en": "Words"
            },
            "estimated_seconds": {
              "zh": "念完约几秒",
              "en": "Read-aloud seconds"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "summary"
          ]
        }
      },
      {
        "name": "extract_hashtags",
        "label": {
          "zh": "提取话题标签",
          "en": "Extract hashtags"
        },
        "description": {
          "zh": "从文案中提取 #话题# 与 #hashtag 标签,按出现的先后;大小写不同的算同一个,纯数字的(#1)不算。",
          "en": "Pull #topic# and #hashtag tags out of a piece of copy, in order of appearance; case-insensitive duplicates and all-digit tags (#1) are skipped."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "hashtags",
            "count",
            "summary"
          ],
          "output_types": {
            "hashtags": "json",
            "count": "number",
            "summary": "text"
          },
          "output_labels": {
            "hashtags": {
              "zh": "话题标签",
              "en": "Hashtags"
            },
            "count": {
              "zh": "个数",
              "en": "Count"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "hashtags"
          ]
        }
      },
      {
        "name": "split_lines",
        "label": {
          "zh": "断成字幕行",
          "en": "Split into subtitle lines"
        },
        "description": {
          "zh": "把一段口播稿断成字幕行:一句一句来,太长的句子在逗号、顿号这类停顿处再切,英文不在词中间断;行尾的逗号、句号按字幕惯例省掉。",
          "en": "Break a script into subtitle lines: sentence by sentence, splitting long sentences at commas and other pauses, never inside an English word; trailing commas and periods are dropped, as subtitles usually do."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            },
            "max_chars": {
              "title": {
                "zh": "每行最多几个字",
                "en": "Max width per line"
              },
              "type": "integer",
              "default": 16,
              "description": {
                "zh": "一个汉字算 1,英文字母、数字算半个。",
                "en": "A CJK character counts as 1; Latin letters and digits count as half."
              }
            },
            "keep_punctuation": {
              "title": {
                "zh": "保留行尾标点",
                "en": "Keep line-end punctuation"
              },
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "lines",
            "count",
            "text",
            "summary"
          ],
          "output_types": {
            "lines": "json",
            "count": "number",
            "text": "text",
            "summary": "text"
          },
          "output_labels": {
            "lines": {
              "zh": "字幕行",
              "en": "Lines"
            },
            "count": {
              "zh": "行数",
              "en": "Line count"
            },
            "text": {
              "zh": "断好的文本",
              "en": "Split text"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "text"
          ]
        }
      },
      {
        "name": "truncate",
        "label": {
          "zh": "按字数截短",
          "en": "Shorten to a length"
        },
        "description": {
          "zh": "把文字截到指定字数以内(省略号算在里面),尽量停在停顿或词的边界上。适合封面文字、简介预览、有字数上限的地方。",
          "en": "Shorten text to a character limit (the ellipsis counts), stopping at a pause or word boundary where possible. Handy for cover text, previews and anywhere with a length cap."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            },
            "max_chars": {
              "title": {
                "zh": "最多几个字",
                "en": "Max characters"
              },
              "type": "integer",
              "default": 20
            },
            "ellipsis": {
              "title": {
                "zh": "省略号",
                "en": "Ellipsis"
              },
              "type": "string",
              "default": "…",
              "description": {
                "zh": "截短时接在末尾;留空就不加。",
                "en": "Appended when the text is cut; leave empty for none."
              }
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "text",
            "chars",
            "removed",
            "summary"
          ],
          "output_types": {
            "text": "text",
            "chars": "number",
            "removed": "number",
            "summary": "text"
          },
          "output_labels": {
            "text": {
              "zh": "截好的文本",
              "en": "Shortened text"
            },
            "chars": {
              "zh": "字数",
              "en": "Characters"
            },
            "removed": {
              "zh": "截掉几个字",
              "en": "Characters removed"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "text"
          ]
        }
      },
      {
        "name": "clean_text",
        "label": {
          "zh": "清理文案",
          "en": "Tidy up copy"
        },
        "description": {
          "zh": "去掉看不见的零宽字符、多余的空格和空行,全角字母数字换成半角;可选把中文后面的半角标点换成全角、在中英文之间加空格、去掉表情。",
          "en": "Remove invisible zero-width characters, stray spaces and extra blank lines, and turn full-width letters and digits half-width; optionally switch half-width punctuation after Chinese to full-width, add spaces between Chinese and Latin text, and strip emoji."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            },
            "chinese_punctuation": {
              "title": {
                "zh": "中文后用全角标点",
                "en": "Full-width punctuation after Chinese"
              },
              "type": "boolean",
              "default": true
            },
            "space_between": {
              "title": {
                "zh": "中英文之间加空格",
                "en": "Space between Chinese and Latin"
              },
              "type": "boolean",
              "default": false
            },
            "remove_emoji": {
              "title": {
                "zh": "去掉表情",
                "en": "Remove emoji"
              },
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "text",
            "chars",
            "summary"
          ],
          "output_types": {
            "text": "text",
            "chars": "number",
            "summary": "text"
          },
          "output_labels": {
            "text": {
              "zh": "清理后的文本",
              "en": "Cleaned text"
            },
            "chars": {
              "zh": "字数",
              "en": "Characters"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "text"
          ]
        }
      },
      {
        "name": "strip_markdown",
        "label": {
          "zh": "Markdown 转纯文本",
          "en": "Markdown to plain text"
        },
        "description": {
          "zh": "去掉标题、加粗、链接、引用这些 Markdown 记号,列表换成「• 」,代码块留代码 —— 得到能直接贴到发布平台上的纯文本。",
          "en": "Remove Markdown marks such as headings, bold, links and quotes, turn list items into \"• \" and keep code as is — plain text ready to paste into a publishing platform."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            },
            "keep_urls": {
              "title": {
                "zh": "链接后面带上网址",
                "en": "Keep link URLs"
              },
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "text",
            "chars",
            "summary"
          ],
          "output_types": {
            "text": "text",
            "chars": "number",
            "summary": "text"
          },
          "output_labels": {
            "text": {
              "zh": "纯文本",
              "en": "Plain text"
            },
            "chars": {
              "zh": "字数",
              "en": "Characters"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "text"
          ]
        }
      },
      {
        "name": "extract_links",
        "label": {
          "zh": "提取链接与提及",
          "en": "Extract links and mentions"
        },
        "description": {
          "zh": "提取文案里的网址、@ 提及和邮箱,各按出现的先后,重复的只留一次。",
          "en": "Pull the links, @mentions and email addresses out of a piece of copy, each in order of appearance, without duplicates."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": {
                "zh": "文本",
                "en": "Text"
              },
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "node": {
          "outputs": [
            "urls",
            "mentions",
            "emails",
            "count",
            "summary"
          ],
          "output_types": {
            "urls": "json",
            "mentions": "json",
            "emails": "json",
            "count": "number",
            "summary": "text"
          },
          "output_labels": {
            "urls": {
              "zh": "网址",
              "en": "Links"
            },
            "mentions": {
              "zh": "@ 提及",
              "en": "Mentions"
            },
            "emails": {
              "zh": "邮箱",
              "en": "Emails"
            },
            "count": {
              "zh": "个数",
              "en": "Count"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          },
          "board_outputs": [
            "urls"
          ]
        }
      }
    ]
  }
}
