{
  "id": "dev.mosael.aliyun-oss",
  "manifest_version": 1,
  "name": {
    "zh": "阿里云 OSS",
    "en": "Alibaba Cloud OSS"
  },
  "default_locale": "zh",
  "version": "0.1.1",
  "homepage": "https://help.aliyun.com/zh/oss/",
  "author": {
    "name": "Mosael",
    "url": "https://mosael.com"
  },
  "docs": {
    "zh": "https://mosael.com/zh/plugins/aliyun-oss",
    "en": "https://mosael.com/en/plugins/aliyun-oss"
  },
  "runtime": {
    "kind": "process",
    "entry": "tools/main.py"
  },
  "permissions": [
    "network:oss"
  ],
  "provides": [
    "public_url"
  ],
  "skills": [
    {
      "id": "oss_storage",
      "description": {
        "zh": "把素材库里的文件传到阿里云 OSS,换回一条**公网直链** —— 有些供应商只收链接不收本地文件(方舟 Seedance 的参考视频就是一例)。也能把桶里的东西拉回素材库。",
        "en": "Upload assets to Alibaba Cloud OSS and get a public link back — some providers only accept a URL, not a local file (Seedance's reference video is one). Also pulls objects back into the library."
      }
    }
  ],
  "instance": {
    "multiple": true,
    "name_template": {
      "zh": "阿里云 OSS · {OSS_BUCKET}",
      "en": "Alibaba Cloud OSS · {OSS_BUCKET}"
    },
    "config": [
      {
        "key": "OSS_BUCKET",
        "label": {
          "zh": "桶名",
          "en": "Bucket"
        },
        "type": "string",
        "required": true,
        "help": {
          "zh": "对象存储的桶名。",
          "en": "The bucket name."
        }
      },
      {
        "key": "OSS_REGION",
        "label": {
          "zh": "区域",
          "en": "Region"
        },
        "type": "string",
        "required": true,
        "default": "cn-hangzhou",
        "help": {
          "zh": "桶所在区域,如 cn-hangzhou。",
          "en": "The bucket's region, e.g. cn-hangzhou."
        }
      },
      {
        "key": "OSS_ENDPOINT",
        "label": {
          "zh": "端点",
          "en": "Endpoint"
        },
        "type": "string",
        "required": false,
        "help": {
          "zh": "通常留空,按区域拼成 oss-<区域>.aliyuncs.com。要填就填完整域名,如 oss-cn-shanghai.aliyuncs.com —— 不是地域名。",
          "en": "Usually empty: built as oss-<region>.aliyuncs.com. If set, give the full host, e.g. oss-cn-shanghai.aliyuncs.com — not a region."
        }
      }
    ],
    "credentials": [
      {
        "key": "OSS_ACCESS_KEY_ID",
        "label": "AccessKey ID",
        "required": true,
        "help": {
          "zh": "阿里云控制台 → RAM 访问控制里建的密钥。建议用只对这个桶有权限的 RAM 用户。",
          "en": "A key from Alibaba Cloud RAM. Prefer a RAM user scoped to this bucket."
        }
      },
      {
        "key": "OSS_ACCESS_KEY_SECRET",
        "label": "AccessKey Secret",
        "required": true,
        "help": {
          "zh": "阿里云控制台 → RAM 访问控制里建的密钥。建议用只对这个桶有权限的 RAM 用户。",
          "en": "A key from Alibaba Cloud RAM. Prefer a RAM user scoped to this bucket."
        }
      }
    ]
  },
  "tools": {
    "expose": "all",
    "declare": [
      {
        "name": "oss_upload",
        "description": {
          "zh": "把一份素材传上去,交回一条**限时直链**(签名在查询串里,桶不必设成公共读)。这就是「本地文件怎么变成公网链接」的答案 —— 直接粘进生成节点的参考视频那一格。",
          "en": "Upload an asset and hand back a time-limited direct link (the signature lives in the query string, so the bucket need not be public-read). This is how a local file becomes a URL."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "asset",
              "description": {
                "zh": "要上传的素材。",
                "en": "The asset to upload."
              }
            },
            "key": {
              "type": "string",
              "description": {
                "zh": "桶里的路径,留空就用 mosael/<原文件名>。",
                "en": "The object key; defaults to mosael/<filename>."
              }
            },
            "expires": {
              "type": "integer",
              "description": {
                "zh": "直链有效期(秒),默认 3600。",
                "en": "How long the link stays valid, in seconds (3600 by default)."
              }
            }
          },
          "required": [
            "asset_id"
          ]
        },
        "node": {
          "output_labels": {
            "url": {
              "zh": "直链",
              "en": "Direct link"
            },
            "public_url": {
              "zh": "公共读地址",
              "en": "Public URL"
            },
            "key": {
              "zh": "对象路径",
              "en": "Object key"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "oss_presign",
        "description": {
          "zh": "给桶里已有的对象签一条限时直链。",
          "en": "Sign a time-limited direct link for an object already in the bucket."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": {
                "zh": "对象路径。",
                "en": "The object key."
              }
            },
            "expires": {
              "type": "integer",
              "description": {
                "zh": "有效期(秒),默认 3600。",
                "en": "Seconds; 3600 by default."
              }
            }
          },
          "required": [
            "key"
          ]
        },
        "read_only": true,
        "node": {
          "output_labels": {
            "url": {
              "zh": "直链",
              "en": "Direct link"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "oss_fetch",
        "description": {
          "zh": "把桶里的一个对象拉回素材库。**交回的是地址,由宿主搬字节** —— 进度、取消、重试都归它。",
          "en": "Pull an object back into the asset library. The plugin hands over a URL and the host moves the bytes — progress, cancel and retry all come for free."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": {
                "zh": "对象路径。",
                "en": "The object key."
              }
            }
          },
          "required": [
            "key"
          ]
        },
        "node": {
          "output_labels": {
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "oss_list",
        "description": {
          "zh": "列出桶里某个前缀下的对象(路径、大小、修改时间)。",
          "en": "List objects under a prefix (key, size, last modified)."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "description": {
                "zh": "路径前缀,留空就是整个桶。",
                "en": "Key prefix; empty means the whole bucket."
              }
            },
            "limit": {
              "type": "integer",
              "description": {
                "zh": "最多返回多少条,默认 100,上限 1000。",
                "en": "How many at most; 100 by default, 1000 at the top."
              }
            }
          },
          "required": []
        },
        "read_only": true,
        "node": {
          "output_labels": {
            "items": {
              "zh": "对象",
              "en": "Objects"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      }
    ]
  }
}
