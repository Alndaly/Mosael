{
  "id": "dev.openstudio.baidu-pan",
  "name": "百度网盘",
  "version": "0.3.0",
  "runtime": {
    "kind": "process",
    "entry": "tools/main.py"
  },
  "permissions": [
    "network:baidu-pan"
  ],
  "skills": [
    {
      "id": "baidu_pan",
      "description": "在百度网盘和素材库之间搬文件。拉:用 pan_list 或 pan_search 找到 fs_id,再用 pan_import 导进来。传:用 pan_upload 把素材库里的东西存到网盘(传 asset_id 和目标路径)。"
    }
  ],
  "instance": {
    "multiple": true,
    "name_template": "百度网盘",
    "credentials": [
      {
        "key": "BAIDU_PAN_APP_KEY",
        "label": "AppKey",
        "required": true,
        "help": "在 pan.baidu.com/union 注册应用后拿到的 AppKey。"
      },
      {
        "key": "BAIDU_PAN_SECRET_KEY",
        "label": "SecretKey",
        "required": true,
        "help": "同一个应用的 SecretKey。"
      },
      {
        "key": "BAIDU_PAN_REFRESH_TOKEN",
        "label": "Refresh Token",
        "required": true,
        "help": "走一次 OAuth 拿到的 refresh_token(有效期 10 年)。填一次就行 —— access_token 由插件自动续,续出来的新值会存回这里。"
      },
      {
        "key": "BAIDU_PAN_ACCESS_TOKEN",
        "label": "Access Token",
        "required": false,
        "help": "留空即可 —— 插件用 refresh_token 自动换,并把换来的存在这里。手动填一个也认。"
      }
    ],
    "config": [
      {
        "key": "BAIDU_PAN_ROOT",
        "label": "起始目录",
        "type": "text",
        "required": false,
        "help": "留空就是网盘根目录 /。填 /我的资源 这样的路径可以让 pan_list 默认从那里开始。"
      }
    ]
  },
  "tools": {
    "expose": "all",
    "declare": [
      {
        "name": "pan_list",
        "description": "列出百度网盘某个目录下的文件和子目录。返回每一项的 fs_id、文件名、大小、是不是目录。fs_id 是后面 pan_import 要用的。",
        "read_only": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "网盘路径,如 /我的资源/素材。留空用起始目录。"
            },
            "limit": {
              "type": "integer",
              "description": "最多返回多少条,默认 100,上限 1000。"
            }
          }
        }
      },
      {
        "name": "pan_search",
        "description": "按文件名在百度网盘里搜索。找不准路径时用这个,比一层层 pan_list 快。返回同样带 fs_id。",
        "read_only": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "文件名关键词"
            },
            "path": {
              "type": "string",
              "description": "限定在这个目录下搜,留空搜全盘"
            }
          },
          "required": [
            "keyword"
          ]
        }
      },
      {
        "name": "pan_import",
        "description": "把百度网盘里的一个文件拉进素材库。传 pan_list / pan_search 给出的 fs_id。返回 asset_id,之后就和别的素材一样用。",
        "input_schema": {
          "type": "object",
          "properties": {
            "fs_id": {
              "type": "string",
              "description": "文件的 fs_id"
            }
          },
          "required": [
            "fs_id"
          ]
        },
        "node": {
          "label": "从百度网盘导入",
          "outputs": [
            "asset_id",
            "asset_name"
          ]
        }
      },
      {
        "name": "pan_upload",
        "description": "把素材库里的一个文件传到百度网盘。传 asset_id 和网盘上的目标路径(如 /我的资源/成片.mp4)。",
        "input_schema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "asset",
              "description": "要上传的素材 id"
            },
            "path": {
              "type": "string",
              "description": "网盘上的目标路径,含文件名"
            },
            "overwrite": {
              "type": "boolean",
              "description": "同名文件已存在时是否覆盖,默认另存为副本"
            }
          },
          "required": [
            "asset_id",
            "path"
          ]
        },
        "node": {
          "label": "上传到百度网盘",
          "outputs": [
            "fs_id",
            "path"
          ]
        }
      }
    ]
  }
}
