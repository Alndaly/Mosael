{
  "id": "dev.mosael.volcengine-tos",
  "manifest_version": 1,
  "name": {
    "zh": "火山引擎 TOS",
    "en": "Volcengine TOS"
  },
  "default_locale": "zh",
  "version": "0.1.0",
  "homepage": "https://www.volcengine.com/docs/6349",
  "runtime": {
    "kind": "process",
    "entry": "tools/main.py"
  },
  "permissions": [
    "network:tos"
  ],
  "skills": [
    {
      "id": "tos_storage",
      "description": {
        "zh": "把素材库里的文件传到火山引擎 TOS,换回一条**公网直链** —— 有些供应商只收链接不收本地文件(方舟 Seedance 的参考视频就是一例)。也能把桶里的东西拉回素材库。**方舟自己的文档就推荐这一家**(「建议存放在 TOS 对象存储服务中」)。",
        "en": "Upload assets to Volcengine TOS and get a public link back — some providers only accept a URL, not a local file (Seedance's reference video is one). Also pulls objects back into the library."
      }
    }
  ],
  "instance": {
    "multiple": true,
    "name_template": {
      "zh": "火山引擎 TOS · {TOS_BUCKET}",
      "en": "Volcengine TOS · {TOS_BUCKET}"
    },
    "config": [
      {
        "key": "TOS_BUCKET",
        "label": {
          "zh": "桶名",
          "en": "Bucket"
        },
        "type": "string",
        "required": true,
        "help": {
          "zh": "对象存储的桶名。",
          "en": "The bucket name."
        }
      },
      {
        "key": "TOS_REGION",
        "label": {
          "zh": "区域",
          "en": "Region"
        },
        "type": "string",
        "required": true,
        "default": "cn-beijing",
        "help": {
          "zh": "桶所在区域,如 cn-beijing。",
          "en": "The bucket's region, e.g. cn-beijing."
        }
      },
      {
        "key": "TOS_ENDPOINT",
        "label": {
          "zh": "端点",
          "en": "Endpoint"
        },
        "type": "string",
        "help": {
          "zh": "留空按区域拼 tos-<区域>.volces.com。",
          "en": "Empty means tos-<region>.volces.com."
        }
      }
    ],
    "credentials": [
      {
        "key": "TOS_ACCESS_KEY",
        "label": "Access Key",
        "required": true,
        "help": {
          "zh": "火山引擎控制台 → 访问控制 → 访问密钥。建议用只对这个桶有权限的子用户。",
          "en": "Volcengine console → IAM → Access Keys. Prefer a sub-user scoped to this bucket."
        }
      },
      {
        "key": "TOS_SECRET_KEY",
        "label": "Secret Key",
        "required": true,
        "help": {
          "zh": "火山引擎控制台 → 访问控制 → 访问密钥。建议用只对这个桶有权限的子用户。",
          "en": "Volcengine console → IAM → Access Keys. Prefer a sub-user scoped to this bucket."
        }
      }
    ]
  },
  "tools": {
    "expose": "all",
    "declare": [
      {
        "name": "tos_upload",
        "description": {
          "zh": "把一份素材传上去,交回一条**限时直链**(签名在查询串里,桶不必设成公共读)。这就是「本地文件怎么变成公网链接」的答案 —— 直接粘进生成节点的参考视频那一格。",
          "en": "Upload an asset and hand back a time-limited direct link (the signature lives in the query string, so the bucket need not be public-read). This is how a local file becomes a URL."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "asset",
              "description": {
                "zh": "要上传的素材。",
                "en": "The asset to upload."
              }
            },
            "key": {
              "type": "string",
              "description": {
                "zh": "桶里的路径,留空就用 mosael/<原文件名>。",
                "en": "The object key; defaults to mosael/<filename>."
              }
            },
            "expires": {
              "type": "integer",
              "description": {
                "zh": "直链有效期(秒),默认 3600。",
                "en": "How long the link stays valid, in seconds (3600 by default)."
              }
            }
          },
          "required": [
            "asset_id"
          ]
        },
        "node": {
          "output_labels": {
            "url": {
              "zh": "直链",
              "en": "Direct link"
            },
            "public_url": {
              "zh": "公共读地址",
              "en": "Public URL"
            },
            "key": {
              "zh": "对象路径",
              "en": "Object key"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "tos_presign",
        "description": {
          "zh": "给桶里已有的对象签一条限时直链。",
          "en": "Sign a time-limited direct link for an object already in the bucket."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": {
                "zh": "对象路径。",
                "en": "The object key."
              }
            },
            "expires": {
              "type": "integer",
              "description": {
                "zh": "有效期(秒),默认 3600。",
                "en": "Seconds; 3600 by default."
              }
            }
          },
          "required": [
            "key"
          ]
        },
        "read_only": true,
        "node": {
          "output_labels": {
            "url": {
              "zh": "直链",
              "en": "Direct link"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "tos_fetch",
        "description": {
          "zh": "把桶里的一个对象拉回素材库。**交回的是地址,由宿主搬字节** —— 进度、取消、重试都归它。",
          "en": "Pull an object back into the asset library. The plugin hands over a URL and the host moves the bytes — progress, cancel and retry all come for free."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": {
                "zh": "对象路径。",
                "en": "The object key."
              }
            }
          },
          "required": [
            "key"
          ]
        },
        "node": {
          "output_labels": {
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      },
      {
        "name": "tos_list",
        "description": {
          "zh": "列出桶里某个前缀下的对象(路径、大小、修改时间)。",
          "en": "List objects under a prefix (key, size, last modified)."
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "description": {
                "zh": "路径前缀,留空就是整个桶。",
                "en": "Key prefix; empty means the whole bucket."
              }
            },
            "limit": {
              "type": "integer",
              "description": {
                "zh": "最多返回多少条,默认 100,上限 1000。",
                "en": "How many at most; 100 by default, 1000 at the top."
              }
            }
          },
          "required": []
        },
        "read_only": true,
        "node": {
          "output_labels": {
            "items": {
              "zh": "对象",
              "en": "Objects"
            },
            "summary": {
              "zh": "一句话",
              "en": "In one line"
            }
          }
        }
      }
    ]
  }
}
